{
  "name": "@holodeck/sdk",
  "version": "0.2.0",
  "description": "Core types and interfaces for the Holodeck ecosystem",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*",
    "src/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "type-check": "tsc -p tsconfig.check.json",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "smoke:dist": "node scripts/smoke-dist.mjs",
    "validate:schema": "ajv compile -c ajv-formats -s ../schema/scenefile.schema.json && ajv compile --spec=draft2020 -c ajv-formats -s ../schema/holodeck-package.v1.schema.json -s ../schema/holodeck-document.v1.schema.json && ajv validate --spec=draft2020 -c ajv-formats -s ../schema/holodeck-package.v1.schema.json -d \"../examples/packages/*.holodeck.package.json\"",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "holodeck",
    "infrastructure",
    "visualization",
    "3d",
    "types",
    "interfaces",
    "sdk"
  ],
  "author": "Hyperdrive Technology",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyperdrive-technology/holodeck-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/hyperdrive-technology/holodeck-sdk/issues"
  },
  "homepage": "https://github.com/hyperdrive-technology/holodeck-sdk#readme",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitest/coverage-v8": "1.6.1",
    "ajv-cli": "5.0.0",
    "ajv-formats": "3.0.1",
    "eslint": "^8.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "peerDependencies": {},
  "engines": {
    "node": ">=26.13.0"
  },
  "packageManager": "pnpm@12.16.1",
  "publishConfig": {
    "access": "public"
  }
}
